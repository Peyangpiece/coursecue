{
  "name": "coursecue",
  "compatibility_date": "2026-10-10",
  "account_id": "3b7ab52765e5610dc37c4abc96d7fef0",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coursecue-private",
      "database_id": "53f28943-4867-4d5f-925d-f8525909fa11",
      "migrations_dir": "migrations"
    }
  ],
  "main": "server/worker.js",
  // 毎日 9:05（日本時間）：SaBoRo の AI の Batch の受け取りと、無料分を超えた分の請求（server/ai.js）
  "triggers": {
    "crons": ["5 0 * * *"]
  }
}
