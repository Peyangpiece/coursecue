{
  "name": "coursecue",
  "compatibility_date": "2026-10-10",
  "account_id": "3b7ab52765e5610dc37c4abc96d7fef0",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coursecue-private",
      "database_id": "53f28943-4867-4d5f-925d-f8525909fa11",
      "migrations_dir": "migrations"
    }
  ],
  "main": "server/worker.js",
  // Workers のログ（console.error の request_failed・定期処理の記録）を Cloudflare に保存する（既定の保持期間）。
  // 要求ごとの自動の記録（invocation logs。URL を含む）は残さない：/api/manifest?connect= の接続キーをログに残さないため
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  // 毎日 9:05（日本時間）：SaBoRo の AI の Batch の受け取りと、無料分を超えた分の請求（server/ai.js）
  "triggers": {
    "crons": ["5 0 * * *"]
  }
}
