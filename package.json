{
  "name": "coursecue",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "python3 -m http.server 8765 --bind 127.0.0.1 --directory dist",
    "deploy:cloudflare": "wrangler deploy",
    "deploy:firebase": "firebase deploy --only hosting --project coursecue-2026",
    "start": "node local/bridge.js",
    "setup": "node local/setup.js",
    "setup:claude-api": "node local/set-claude-key.js",
    "test": "node --test tests/*.test.js",
    "install:agent": "node local/install-agent.js",
    "seed": "node local/seed.js"
  },
  "devDependencies": {
    "firebase-tools": "15.33.0",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "adm-zip": "^0.6.1",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.64.0"
  }
}
