{
  "name": "coursecue",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "python3 -m http.server 8765 --bind 127.0.0.1 --directory dist",
    "deploy:cloudflare": "wrangler deploy",
    "deploy:firebase": "firebase deploy --only hosting --project coursecue-2026",
    "start": "node local/bridge.js",
    "setup": "node local/setup.js",
    "setup:claude-api": "node local/set-claude-key.js",
    "check:claude-api": "node local/check-claude-key.js",
    "test": "node --test tests/*.test.js",
    "install:agent": "node local/install-agent.js",
    "seed": "node local/seed.js",
    "desktop": "electron .",
    "desktop:build": "electron-builder --publish never",
    "desktop:release": "electron-builder --publish always"
  },
  "devDependencies": {
    "firebase-tools": "15.33.0",
    "wrangler": "4.149.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "adm-zip": "^0.6.1",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.64.0",
    "electron-updater": "^6.8.9"
  },
  "version": "1.0.21",
  "description": "saboro デスクトップ：授業・課題・提出状況・出席を管理する",
  "main": "desktop/main.js",
  "build": {
    "appId": "jp.coursecue.saboro",
    "productName": "saboro",
    "artifactName": "saboro-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "local/**",
      "dist/icon-512.png",
      "dist/academic-calendar.json",
      "dist/saboro-logo.svg",
      "package.json",
      "!local/keychain",
      "!local/keychain.swift",
      "!local/install-agent.js",
      "!local/setup.js",
      "!local/seed.js"
    ],
    "asarUnpack": [
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "Peyangpiece",
      "repo": "SaBoRo"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "dist/icon-512.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "dist/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "language": "1041"
    },
    "dmg": {
      "sign": false
    }
  }
}
